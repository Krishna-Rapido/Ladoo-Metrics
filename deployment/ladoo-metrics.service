[Unit]
Description=Ladoo Metrics Backend API
After=network.target

[Service]
Type=simple
User=ladoo
Group=ladoo
WorkingDirectory=/opt/ladoo-metrics/backend
Environment="PATH=/opt/ladoo-metrics/backend/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PORT=8001"
Environment="TRINO_HOST=bi-trino-4.processing.data.plectrum.dev"
Environment="TRINO_PORT=443"
Environment="TRINO_HTTP_SCHEME=https"
Environment="TRINO_CATALOG=hive"
# Persists the OAuth2 token across restarts/workers. First query after a fresh
# login logs a URL (journalctl -u ladoo-metrics) — open it once to authenticate.
Environment="TRINO_TOKEN_CACHE_FILE=/opt/ladoo-metrics/.trino/token-cache.cfg"
Environment="SUPABASE_URL=https://croniadpudboidlouhuu.supabase.co"
Environment="SUPABASE_ANON_KEY=sb_publishable_XVL1eAexg-C1MpKPPC-b2Q_hl2pFTpT"
# Scheduler: set SUPABASE_SERVICE_KEY to enable dashboard precomputation
# Environment="SUPABASE_SERVICE_KEY=your-service-role-key-here"
Environment="MAX_PRESTO_CONCURRENT=4"
# CORS: not needed when frontend & API are same-origin behind Nginx.
# If you ever serve the API on a separate origin, uncomment and set:
# Environment="ALLOWED_ORIGINS=http://laddoo.labs.plectrum.dev"
ExecStart=/opt/ladoo-metrics/backend/venv/bin/python /opt/ladoo-metrics/backend/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ladoo-metrics

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ladoo-metrics/backend/temp_uploads /var/log/ladoo-metrics
ReadOnlyPaths=/opt/ladoo-metrics

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
