# Supabase
SUPABASE_URL=https://croniadpudboidlouhuu.supabase.co
SUPABASE_ANON_KEY=sb_publishable_XVL1eAexg-C1MpKPPC-b2Q_hl2pFTpT
SUPABASE_SERVICE_KEY=  # Optional: set to service-role key for scheduler (bypasses RLS)

# Trino (OAuth2). Defaults below match the Plectrum cluster; override only if it moves.
TRINO_HOST=bi-trino-4.processing.data.plectrum.dev
TRINO_PORT=443
TRINO_HTTP_SCHEME=https
TRINO_CATALOG=hive
# Persist the OAuth2 bearer token to a file-backed keyring so the one-time browser
# login survives restarts and is shared across workers. Leave unset locally (uses
# the OS keychain). On the headless VM, set a path under a private 0600 directory.
TRINO_TOKEN_CACHE_FILE=/opt/ladoo-metrics/.trino/token-cache.cfg

# Scheduler
MAX_PRESTO_CONCURRENT=4
SCHEDULER_POLL_INTERVAL=60

# Server
PORT=8001
ALLOWED_ORIGINS=http://localhost:5173

# AI (required for /ai/* routes)
OPENAI_API_KEY=
